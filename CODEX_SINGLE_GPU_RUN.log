import json
from html.parser import HTMLParser
from pathlib import Path
class Cells(HTMLParser):
 def __init__(self):super().__init__();self.capture=False;self.cells=[]
 def handle_starttag(self,tag,attrs):
  if tag=='span' and dict(attrs).get('data-editable')=='true':self.capture=True;self.cells.append('')
 def handle_data(self,data):
  if self.capture:self.cells[-1]+=data
 def handle_endtag(self,tag):
  if tag=='span':self.capture=False
p=Cells();p.feed(Path('profiling/results/quick-live-20260908/1/page.html').read_text())
c=[x.strip() for x in p.cells]
print('Captured lamp region cells:',c)
Path('profiling/results/quick-live-20260908/first-lamp/plan.json').write_text(json.dumps({'shape_prompt':'lamp','braille_label':'lamp','regions':[dict(zip(('part_prompt','texture_prompt'),c[i:i+2])) for i in range(0,len(c),2)],'source':'saved real browser DOM'},indent=2))
