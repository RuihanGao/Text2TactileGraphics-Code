import json
from pathlib import Path
from playwright.sync_api import sync_playwright
with sync_playwright() as p:
    browser = p.chromium.launch(headless=True,args=['--no-sandbox'])
    page = browser.new_page(viewport={'width':390,'height':844},is_mobile=True,has_touch=True)
    errors=[]
    page.on('pageerror',lambda exc: errors.append(str(exc)))
    page.goto('http://127.0.0.1:18761',wait_until='domcontentloaded')
    page.get_by_role('button',name='Generate',exact=True).wait_for(timeout=30000)
    page.screenshot(path='output-quick-trial/mobile-start.png',full_page=True)
    assert page.get_by_text('Customize intermediate steps',exact=True).is_visible()
    assert not page.get_by_label('Shape prompt',exact=True).is_visible()
    assert page.evaluate('document.documentElement.scrollWidth <= window.innerWidth')
    page.get_by_label('What would you like to create?',exact=True).fill('lamp, the base of the lamp has a tree bark texture, and the lamp shade has a cloth_bag texture.')
    page.get_by_role('button',name='Generate',exact=True).click()
    page.locator('#quick-status').get_by_text('Done',exact=True).wait_for(timeout=60000)
    page.wait_for_timeout(5000)
    with page.expect_download() as transfer:
        page.get_by_text('Download mesh',exact=True).click()
    downloaded=transfer.value
    assert downloaded.failure() is None
    assert Path(downloaded.path()).stat().st_size > 100
    page.screenshot(path='output-quick-trial/mobile-done.png',full_page=True)
    page.get_by_text('Customize intermediate steps',exact=True).click()
    page.get_by_label('Braille label',exact=True).fill('light')
    before=json.loads(Path('/tmp/quick-browser-counts.json').read_text())
    page.get_by_role('button',name='Apply edits and continue',exact=True).click()
    page.wait_for_timeout(3000)
    assert page.locator('#quick-status').inner_text()=='Done'
    after=json.loads(Path('/tmp/quick-browser-counts.json').read_text())
    assert after['generate_final_mesh']==before['generate_final_mesh']+1
    assert after['generate_base_image']==before['generate_base_image']
    assert after['generate_texture_image']==before['generate_texture_image']
    assert page.evaluate('document.documentElement.scrollWidth <= window.innerWidth')
    Path('output-quick-trial/browser.json').write_text(json.dumps({'viewport':[390,844],'no_horizontal_overflow':True,'braille_rerun_only_final':True,'mesh_download_succeeded':True,'before':before,'after':after,'browser_errors':errors},indent=2))
    assert not errors,errors
    browser.close()
