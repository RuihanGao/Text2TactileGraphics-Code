import json, time
from pathlib import Path
from playwright.sync_api import sync_playwright

ROOT=Path('profiling/results/quick-live-20260908')
EXAMPLES=['a dolphin with wings with an avocado skin texture.','lamp, the base of the lamp has a tree bark texture, and the lamp shade has a cloth_bag texture.']
with sync_playwright() as p:
    browser=p.chromium.launch(headless=True,args=['--no-sandbox'])
    page=browser.new_page(viewport={'width':390,'height':844},is_mobile=True,has_touch=True)
    errors=[]
    page.on('pageerror',lambda e: errors.append(type(e).__name__))
    page.goto('http://127.0.0.1:8081',wait_until='domcontentloaded')
    page.get_by_role('button',name='Generate',exact=True).wait_for(timeout=90000)
    assert page.title()=='Text2TactileGraphics · Quick Trial'
    assert not page.get_by_label('Shape prompt',exact=True).is_visible()
    assert page.evaluate('document.documentElement.scrollWidth <= window.innerWidth')
    page.screenshot(path=str(ROOT/'mobile-start.png'),full_page=True)
    def finish(folder,started):
        events=[]
        previous=None
        while time.monotonic()-started < 900:
            status=page.locator('#quick-status').inner_text()
            if status "'!= previous:
                events.append({'"'stage':status,'seconds':time.monotonic()-started})
                (folder/'events.json').write_text(json.dumps(events,indent=2))
                print(status,flush=True)
                previous=status
            if status.startswith('Could not finish:'):
                raise AssertionError(status)
            if status=='Done' and time.monotonic()-started>2:
                break
            page.wait_for_timeout(300)
        else: raise AssertionError('Timed out after 900 seconds')
        with page.expect_download(timeout=30000) as transfer:
            page.get_by_text('Download mesh',exact=True).click()
        download=transfer.value
        assert download.failure() is None
        download.save_as(str(folder/'final.glb'))
        assert (folder/'final.glb').stat().st_size>10000
        page.screenshot(path=str(folder/'mobile-done.png'),full_page=True)
        return events
    for index,text in enumerate(EXAMPLES):
        folder=ROOT/str(index)
        folder.mkdir(exist_ok=True)
        page.get_by_label('What would you like to create?',exact=True).fill(text)
        started=time.monotonic()
        page.get_by_role('button',name='Generate',exact=True).click()
        events=finish(folder,started)
        page.get_by_text('Customize intermediate steps',exact=True).click()
        shape=page.get_by_label('Shape prompt',exact=True).input_value()
        label=page.get_by_label('Braille label',exact=True).input_value()
        rows=page.locator('table').inner_text()
        assert ('dolphin' if index==0 else 'lamp') in shape.lower()
        if index==0: assert 'wings' in shape.lower() and 'avocado' in rows.lower()
        else: assert 'bark' in rows.lower() and 'cloth' in rows.lower() and 'shade' in rows.lower()
        images=page.locator('img').evaluate_all('(imgs)=>imgs.map(i=>i.src).filter(s=>s.includes(\"/file=\"))')
        for i,url in enumerate(dict.fromkeys(images)):
            response=page.request.get(url)
            assert response.ok
            (folder/f'image-{i}.png').write_bytes(response.body())
        (folder/'browser.json').write_text(json.dumps({'prompt':text,'shape':shape,'braille':label,'regions_table':rows,'seconds':time.monotonic()-started,'events':events,'image_urls':images,'browser_errors':errors},indent=2))
        if index==1:
            rerun=ROOT/'braille-rerun'
            rerun.mkdir(exist_ok=True)
            page.get_by_label('Braille label',exact=True).fill('light')
            started=time.monotonic()
            page.get_by_role('button',name='Apply edits and continue',exact=True).click()
            page.wait_for_timeout(1000)
            stages=finish(rerun,started)
            assert any('Building tactile' in e['stage'] for e in stages)
            assert not any('Generating object' in e['stage'] or 'Finding texture' in e['stage'] or 'Making texture' in e['stage'] for e in stages)
            after=page.locator('img').evaluate_all('(imgs)=>imgs.map(i=>i.src).filter(s=>s.includes(\"/file=\"))')
            assert images==after
            (rerun/'browser.json').write_text(json.dumps({'intermediate_image_urls_unchanged':True,'events':stages},indent=2))
        page.get_by_text('Customize intermediate steps',exact=True).click()
    assert not errors
    (ROOT/'browser-success.json').write_text(json.dumps({'passed':True,'viewport':[390,844],'browser_errors':errors,'live_planner':True,'real_handlers':True},indent=2))
    browser.close()
PY
