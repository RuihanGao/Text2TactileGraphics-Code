import json
import time
from pathlib import Path
import numpy as np
from PIL import Image
import trimesh
from text2tactilegraphics.ui import quick_pipeline as qp
from text2tactilegraphics.ui.prompt_planner import PromptPlan
from text2tactilegraphics.ui.public_app import create_demo, CSS

counts = {}
img = Image.new('RGB', (128,128), '#dfbd88')
trimesh.creation.box().export('/tmp/quick-browser-mesh.glb')

def handler(name, value):
    def call(*args, **kwargs):
        counts[name] = counts.get(name,0) + 1
        Path('/tmp/quick-browser-counts.json').write_text(json.dumps(counts))
        time.sleep(0.1)
        return value
    return call
for name, value in {'generate_base_image':img,'segment_with_text':(np.ones((128,128),bool),img),'generate_texture_image':img,'generate_texture_geometry':(np.ones((128,128,3)),img),'make_tileable':img,'generate_final_mesh':'/tmp/quick-browser-mesh.glb'}.items():
    setattr(qp.handlers, name, handler(name,value))
class Planner:
    def plan(self, text):
        return PromptPlan(shape_prompt='lamp',regions=[{'part_prompt':'base of the lamp','texture_prompt':'tree bark texture'},{'part_prompt':'lamp shade','texture_prompt':'cloth_bag texture'}],braille_label='lamp')
create_demo(planner=Planner()).launch(server_name='127.0.0.1',server_port=18761,css=CSS)

