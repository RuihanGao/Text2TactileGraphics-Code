    events=json.loads(p.with_name('events.json').read_text())
    r={'vertices':len(m.vertices),'faces':len(m.faces),'bytes':p.stat().st_size,'watertight':bool(m.is_watertight),'winding_consistent':bool(m.is_winding_consistent),'boundary_edges':int((counts==1).sum()),'nonmanifold_edges':int((counts>2).sum()),'finite_vertices':bool(np.isfinite(m.vertices).all()),'done_seconds':events[-1]['seconds']}
    assert r['finite_vertices'] and r['vertices']>0 and r['faces']>0
    p.with_name('mesh-validity.json').write_text(json.dumps(r,indent=2))
    results[p.parent.name]=r
(root/'mesh-results.json').write_text(json.dumps(results,indent=2))
print(json.dumps(results,indent=2))
